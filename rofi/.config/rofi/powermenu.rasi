// ~/.config/rofi/powermenu.rasi
// Theme for powermenu.sh, using the same generated palette as config.rasi.
// Style every element state explicitly (see config.rasi).

@import "colors"

* {
    background-color: transparent;
    text-color:       @text;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            300px;
    location:         center;
    anchor:           center;
    border-radius:    0;
    border:           1px;
    border-color:     @border-col;
    background-color: @bg;
    padding:          0;
}

mainbox {
    children: [ "inputbar", "message", "listview" ];
    spacing:  0;
}

// The prompt (user@host) is the title; the entry is hidden (typing still filters).
inputbar {
    children:     [ "prompt" ];
    padding:      10px 12px;
    border:       0 0 1px 0;
    border-color: @border-col;
}

prompt {
    text-color: @dim;
}

message {
    padding:      6px 12px;
    border:       0 0 1px 0;
    border-color: @border-col;
}

textbox {
    text-color: @muted;
    font:       "FiraCode Nerd Font 10";
}

listview {
    lines:        5;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    padding:      6px;
    spacing:      0;
}

element {
    padding:       9px 12px;
    border-radius: 0;
    spacing:       10px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @dim;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @text;
}

element selected.normal {
    background-color: @surface-hi;
    text-color:       @accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element selected.active {
    background-color: @surface-hi;
    text-color:       @accent;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    cursor:         inherit;
}
