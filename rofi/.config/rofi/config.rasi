// ~/.config/rofi/config.rasi
// Colours come from colors.rasi (generated by scripts/theme.sh); no hex values
// here. Don't @theme a file from /usr/share: a missing one fails silently.

@import "colors"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "FiraCode Nerd Font 11";
    display-drun: "Apps";
    drun-display-format: "{name}";
    hover-select: true;
}

* {
    background-color: transparent;
    text-color:       @text;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            640px;
    location:         center;
    anchor:           center;
    border-radius:    0;
    border:           1px;
    border-color:     @border-col;
    background-color: @bg;
    padding:          0;
}

mainbox {
    children: [ "inputbar", "listview" ];
    spacing:  0;
}

inputbar {
    children:      [ "prompt", "entry" ];
    padding:       10px 12px;
    spacing:       8px;
    border:        0 0 1px 0;
    border-color:  @border-col;
}

prompt {
    text-color: @dim;
}

entry {
    placeholder:       "Search";
    placeholder-color: @muted;
    text-color:        @text;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    padding:      6px;
    spacing:      0;
}

element {
    padding:       7px 10px;
    border-radius: 0;
    spacing:       10px;
}

/* Style every element state explicitly: rofi's built-in default theme gives
 * them a light cream background that the `*` block doesn't override. */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @dim;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @text;
}

element selected.normal {
    background-color: @surface-hi;
    text-color:       @accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element selected.active {
    background-color: @surface-hi;
    text-color:       @accent;
}

element-icon {
    size:   1.1em;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    cursor:         inherit;
}
