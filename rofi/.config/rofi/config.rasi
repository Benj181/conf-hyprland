// ~/.config/rofi/config.rasi
//
// colors.rasi is generated by scripts/theme.sh from the active palette. This
// used to `@theme` a file out of /usr/share/rofi/themes/, and rofi silently
// fell back to its stock theme because nothing was there. Arch's rofi does
// ship themes in that directory, which makes the rule more worth keeping
// rather than less: a distro theme path is not yours, its contents change
// under you, and a miss is silent. Never depend on one.
//
// colors.rasi only defines colours; the layout below is ours. No hex values
// here -- they would not follow a palette switch.

@import "colors"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "FiraCode Nerd Font 11";
    display-drun: "Apps";
    drun-display-format: "{name}";
    hover-select: true;
}

* {
    background-color: transparent;
    text-color:       @text;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            640px;
    location:         center;
    anchor:           center;
    // Square and 1px, matching the window borders and the bar. A fixed pixel
    // width rather than 40%: on a 2560px monitor that was a 1024px-wide
    // launcher for a list of application names.
    border-radius:    0;
    border:           1px;
    border-color:     @border-col;
    background-color: @bg;
    padding:          0;
}

mainbox {
    children: [ "inputbar", "listview" ];
    spacing:  0;
}

// The prompt is a separator line rather than a filled box. A surface-coloured
// input field is a visible panel; a rule under it is the same information with
// nothing drawn.
inputbar {
    children:      [ "prompt", "entry" ];
    padding:       10px 12px;
    spacing:       8px;
    border:        0 0 1px 0;
    border-color:  @border-col;
}

prompt {
    text-color: @dim;
}

entry {
    placeholder:       "Search";
    placeholder-color: @muted;
    text-color:        @text;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    padding:      6px;
    spacing:      0;
}

element {
    padding:       7px 10px;
    border-radius: 0;
    spacing:       10px;
}

/* Every element state must be set explicitly. rofi always loads its built-in
 * default theme first, and that theme defines `background: rgba(253,246,227)`
 * -- Solarized light cream -- which `element normal.normal` inherits. The `*`
 * block above does not win against a selector that specific, so any state left
 * unstyled here renders with a cream background on a dark theme. */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @dim;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @text;
}

/* Selection is a grey block with white text, not an accent fill. This is the
 * one row you are looking at, and brightness carries that as well as hue did. */
element selected.normal {
    background-color: @surface-hi;
    text-color:       @accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element selected.active {
    background-color: @surface-hi;
    text-color:       @accent;
}

element-icon {
    size:   1.1em;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    cursor:         inherit;
}
