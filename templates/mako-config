# GENERATED from palettes/{{palette}}.env by scripts/theme.sh -- do not edit.
# Edit templates/mako-config and re-run the script.
# mako has no include, so the whole file is generated: edit the template.

background-color={{bg}}ee
text-color={{text}}
border-color={{border}}
progress-color=over {{surface_hi}}
border-size=1
border-radius=0
padding=10
margin=6
default-timeout=5000
max-visible=5
layer=overlay
anchor=top-right
font=FiraCode Nerd Font 11


[urgency=low]
text-color={{dim}}
border-color={{border}}

[urgency=normal]
border-color={{border}}

# Only critical notifications get colour.
[urgency=high]
border-color={{urgent}}
text-color={{text}}
default-timeout=0
