# palettes/mono-cool.env
# Cool greyscale -- a slight blue cast, sitting where Catppuccin Mocha's base
# did. The shortest jump from the old scheme: same temperature, none of the
# saturation.
#
# Blue-tinted darks read as deeper than neutral ones at the same luminance, so
# this looks a shade blacker than mono-neutral despite bg being lighter.
#
# See palettes/mono-neutral.env for what each key is used for; the key list is
# a contract with templates/ and every palette must define all of it.

name="mono-cool"

# --- greyscale ramp, darkest to lightest ------------------------------------
bg="#0f1115"
bg_alt="#141720"
surface="#181b21"
surface_hi="#222630"
border="#2a2e36"
muted="#575e6b"
dim="#808795"
text="#d4d8e0"
accent="#eef1f6"

# --- state colours ----------------------------------------------------------
urgent="#bc5f6a"
warn="#a08a58"
good="#6d8f7d"

# --- terminal / editor accents ---------------------------------------------
red="#ab6a74"
green="#7f9b87"
yellow="#a3a077"
blue="#7d94b4"
magenta="#9c86b0"
cyan="#7fa4a8"

red_br="#c0838c"
green_br="#97b09e"
yellow_br="#bab78e"
blue_br="#95a9c6"
magenta_br="#b29ec4"
cyan_br="#96b9bd"
