# palettes/mono-neutral.env
# Neutral greyscale. No hue anywhere in the desktop chrome.
#
# This file is the single source of truth for colour. Nothing else in the repo
# should contain a hex value -- scripts/theme.sh renders it into the per-app
# colour files, and those are what waybar/rofi/kitty/etc. read. If you find a
# hardcoded colour outside palettes/ and templates/, it is a bug: it will not
# follow a palette switch and the rice will drift out of sync one app at a time.
#
# Format: KEY="#rrggbb", one per line, sourced by bash. Keys are the contract
# with templates/ -- adding a palette means providing every key below, so copy
# this file rather than writing one from scratch. theme.sh derives three
# placeholder forms from each key automatically, so a template can ask for
# {{bg}} -> #0e0e0e, {{bg_raw}} -> 0e0e0e, or {{bg_rgb}} -> 14, 14, 14.

name="mono-neutral"

# --- greyscale ramp, darkest to lightest ------------------------------------
# Eight stops rather than the five the eye needs, because the gaps are where
# banding shows up: surface/surface_hi have to be distinguishable as "panel"
# vs "hovered panel" at 13px on a bar 30px tall, and muted/dim have to be
# distinguishable as "disabled" vs "secondary" in the same glance.
bg="#0e0e0e"         # root background: bar, terminal, rofi, lock screen
bg_alt="#141414"     # a hair lighter -- inactive tabs, alternating rows
surface="#1a1a1a"    # raised: selections, pressed states, input fields
surface_hi="#242424" # raised + hovered
border="#2e2e2e"     # inactive window borders, separators, outlines
muted="#5a5a5a"      # disabled, comments, off states
dim="#8a8a8a"        # secondary text, inactive workspace numbers
text="#e6e6e6"       # primary text
accent="#ffffff"     # focus: active window border, active workspace, cursor

# --- state colours ----------------------------------------------------------
# The only hue in the desktop chrome, and only where losing the signal would
# cost something: a muted battery and a critical one must not look alike.
# Everything in waybar/hyprland/rofi/mako outside these three is greyscale.
urgent="#c04040"     # critical: >90% memory, urgent window, failed unlock
warn="#a8894f"       # warning: >75% memory, low battery
good="#6f8f6f"       # rarely used; confirmations

# --- terminal / editor accents ---------------------------------------------
# Desaturated to roughly 25% so they read as tinted greys next to the ramp
# above, but stay far enough apart to survive their actual job: a red/green
# git diff, an ANSI error, treesitter groups. A literally achromatic terminal
# makes `git diff` and `ls` output unreadable, which is a usability loss the
# monochrome look does not require -- zenwritten (the nvim colorscheme this
# pairs with) makes the same trade for the same reason.
red="#b0656a"
green="#86a186"
yellow="#ada273"
blue="#8296ae"
magenta="#a382a8"
cyan="#85a6a6"

# Bright ANSI variants (colour8-15). Lifted ~12% in luminance, not saturated
# further -- brightening by adding chroma is what makes "muted" palettes look
# muddy in one half of the terminal and garish in the other.
red_br="#c47b80"
green_br="#9cb79c"
yellow_br="#c3b889"
blue_br="#98acc4"
magenta_br="#b998be"
cyan_br="#9bbcbc"
