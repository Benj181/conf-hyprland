# palettes/mono-neutral.env
# Neutral greyscale. No hue anywhere in the desktop chrome.
#
# Palettes are the only place colours are defined; scripts/theme.sh renders
# them through templates/. A hex value anywhere else won't follow a switch.
#
# Format: key="#rrggbb", one per line, quotes required. Every palette must
# define all keys below; copy this file to make a new one. Templates can use
# {{bg}} -> #0e0e0e, {{bg_raw}} -> 0e0e0e, or {{bg_rgb}} -> 14, 14, 14.

name="mono-neutral"

# --- greyscale ramp, darkest to lightest ------------------------------------
bg="#0e0e0e"         # root background: bar, terminal, rofi, lock screen
bg_alt="#141414"     # a hair lighter -- inactive tabs, alternating rows
surface="#1a1a1a"    # raised: selections, pressed states, input fields
surface_hi="#242424" # raised + hovered
border="#2e2e2e"     # inactive window borders, separators, outlines
muted="#5a5a5a"      # disabled, comments, off states
dim="#8a8a8a"        # secondary text, inactive workspace numbers
text="#e6e6e6"       # primary text
accent="#ffffff"     # focus: active window border, active workspace, cursor

# --- state colours ----------------------------------------------------------
# The only hues in the desktop chrome.
urgent="#c04040"     # critical: >90% memory, urgent window, failed unlock
warn="#a8894f"       # warning: >75% memory, low battery
good="#6f8f6f"       # rarely used; confirmations

# --- terminal / editor accents ---------------------------------------------
# ~25% saturation: muted, but red/green stay distinguishable in diffs.
red="#b0656a"
green="#86a186"
yellow="#ada273"
blue="#8296ae"
magenta="#a382a8"
cyan="#85a6a6"

# Bright ANSI variants (colour8-15): ~12% lighter, same saturation.
red_br="#c47b80"
green_br="#9cb79c"
yellow_br="#c3b889"
blue_br="#98acc4"
magenta_br="#b998be"
cyan_br="#9bbcbc"
