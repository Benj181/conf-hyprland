# palettes/mono-warm.env
# Warm greyscale -- a slight brown cast through the whole ramp, in the
# Gruvbox-material register. Still monochrome: no stop here is more than ~8
# RGB points away from neutral, which is enough to take the clinical edge off
# a pure grey without reading as a colour scheme.
#
# Easier on the eyes than mono-neutral over a long session, at the cost of
# looking slightly "off-white" next to anything genuinely neutral on screen --
# a white browser page next to this makes the desktop look tinted.
#
# See palettes/mono-neutral.env for what each key is used for; the key list is
# a contract with templates/ and every palette must define all of it.

name="mono-warm"

# --- greyscale ramp, darkest to lightest ------------------------------------
bg="#121110"
bg_alt="#191614"
surface="#1d1b19"
surface_hi="#2a2724"
border="#322f2c"
muted="#5e574f"
dim="#8c837a"
text="#ddd6ce"
accent="#f2ece4"

# --- state colours ----------------------------------------------------------
urgent="#c05a50"
warn="#b08a4a"
good="#7d8f6a"

# --- terminal / editor accents ---------------------------------------------
red="#b06a66"
green="#8a9b76"
yellow="#b09a68"
blue="#7f8d9b"
magenta="#a3849a"
cyan="#82a0a0"

red_br="#c48480"
green_br="#a1b08f"
yellow_br="#c4b184"
blue_br="#96a3b0"
magenta_br="#b89bb1"
cyan_br="#9bb6b6"
